.26,61.99],[21.34,62.28],[21.1,62.62],[21.47,63.03],[21.65,63.04],[21.55,63.2],[22.32,63.31],[22.24,63.44],[22.53,63.65],[23.76,64.2],[36.0,64.2],[36.0,55.2],[21.23,55.2]],[[23.32,58.45],[22.37,58.22],[22.08,57.94],[21.99,58.0],[22.19,58.15],[21.85,58.3],[21.98,58.39],[21.86,58.5],[22.55,58.63],[23.32,58.45]],[[22.47,58.71],[22.41,58.86],[22.06,58.94],[22.65,59.09],[22.98,58.92],[22.47,58.71]]],"pos":"tr","arrows":[{"side":"ax","d0":0.05,"d1":0.9,"pts":[[18.2,59.5],[20.3,59.5],[23.5,59.75],[27,60],[30.3,59.93]]},{"side":"su","d0":2,"d1":3.5,"pts":[[31.27,58.52],[32.29,60],[30.6,59.8]]}],"cities":[{"n":"Уппсала","ll":[17.64,59.86],"al":"right"},{"n":"Новгород","ll":[31.27,58.52],"al":"right"},{"n":"Рига","ll":[24.1,56.95]}]},"intro":"<div class=\"vhm-ch\"><span class=\"vhm-cd\">ก่อนฤดูร้อน 1240</span></div><b>รุสถูกบีบจากสองทิศ</b><p>ปี 1237–1240 กองทัพมองโกลของบาตูข่านทำลายเมืองรุสทางตะวันออกและใต้ ขณะเดียวกันทางตะวันตกเฉียงเหนือ สมเด็จพระสันตะปาปาประกาศสงครามครูเสดในฟินแลนด์ (1237) เดนมาร์กกับคณะอัศวินตกลงแบ่งเอสโตเนียและร่วมกับสวีเดนกดดันนอฟโกรอด <span class=\"vhm-ru\">(Великий Новгород)</span> ซึ่งรอดจากมองโกล เป้าหมายคือแม่น้ำเนวา — ทางน้ำจากทะเลบอลติกสู่ทะเลสาบลาโดกาและนอฟโกรอด เจ้าชายของนอฟโกรอดคืออเล็กซานเดอร์ ยาโรสลาวิช <span class=\"vhm-ru\">(Александр Ярославич)</span> อายุเพียง 19 ปี</p><div class=\"vhm-more\">แผนที่เริ่มจากภาพกว้าง (การเดินทัพ) แล้วซูมเข้าสนามรบที่ปากแม่น้ำอิจอรา</div>","tables":[{"title":"กำลังรบและความสูญเสีย (สไลด์ 13 เทียบกับพงศาวดาร)","open":true,"head":["","Русь (Александр)","Швеция"],"rows":[["กำลังพล — สไลด์","น้อยกว่า 1 500","5 000 · เรือ 100 ลำ"],["ผู้บังคับบัญชา — สไลด์","Александр Ярославич","ярл Ульф Фаси, ярл Биргер"],["เป้าหมาย — สไลด์","остановить вторжение шведов","захват устья Невы, поход на Новгород"],["ความสูญเสีย — สไลด์","20","600"],["พงศาวดารนอฟโกรอดฉบับที่ 1","ถึง 20 «мужей» (ชนชั้นสูง ไม่นับบริวาร)","ศพชนชั้นสูงเต็มเรือ 2 ลำ + ศพอื่น «бещисла» ในหลุม"],["จำนวนกำลังในแหล่งร่วมสมัย","ไม่ระบุ","ไม่ระบุ · ไม่มีในแหล่งสวีเดนเลย"]],"note":"ตัวเลข 5 000 / 100 ลำ / 600 / น้อยกว่า 1 500 ไม่มีในพงศาวดาร เป็นตัวเลขของตำราภายหลัง — ในห้องสอบตอบตามสไลด์ แต่ควรรู้ว่าเป็นการประเมิน (ผู้เรียบเรียง: ru.wikipedia «Невская битва»)"}],"events":[{"d":0.05,"key":1,"at":[30.605,59.806],"h":"กองเรือสวีเดนเข้าแม่น้ำเนวา","ru":"шведы: цель — захват устья Невы, поход на Новгород","tx":"ฤดูร้อน 1240 เรือสวีเดนแล่นจากทะเลบอลติกผ่านอ่าวฟินแลนด์เข้าแม่น้ำเนวา แล้วขึ้นฝั่งตั้งค่ายที่ปากแม่น้ำอิจอรา <span class=\"vhm-ru\">(Ижора)</span> ตามสไลด์เป้าหมายคือยึดปากแม่น้ำเนวา แล้วบุกต่อไปลาโดกาและนอฟโกรอด","warn":"สไลด์ 13 ให้ผู้นำสวีเดนสองคน «ярл Ульф Фаси, ярл Биргер» แต่ในปี 1240 ยาร์ลของสวีเดนคืออุลฟ์ ฟาซี เบียร์เยอร์ได้เป็นยาร์ลในปี 1248 การที่เบียร์เยอร์อยู่ที่เนวาจึงยังเป็นที่ถกเถียง (ru/en.wikipedia)","src":"สไลด์ 13 · เส้นทาง: ผู้เรียบเรียง"},{"d":1,"at":[30.605,59.8045],"h":"ยามทะเลชาวอิจอรารายงานข่าว","ru":"Пелгусий — «морская стража»","tx":"เปลกูซี <span class=\"vhm-ru\">(Пелгусий)</span> ผู้อาวุโสของชาวอิจอรา ผู้ทำหน้าที่ยามชายฝั่งให้นอฟโกรอด พบกองเรือข้าศึกและส่งคนไปรายงานอเล็กซานเดอร์ทันที — ระบบเตือนภัยล่วงหน้าของรุสทำงาน","src":"ผู้เรียบเรียง (ru.wikipedia «Невская битва»)"},{"d":1.5,"fun":1,"at":[30.605,59.8045],"h":"นิมิตของเปลกูซี","ru":"видение Бориса и Глеба","tx":"ตาม «ชีวประวัติของอเล็กซานเดอร์ เนฟสกี» <span class=\"vhm-ru\">(Житие)</span> รุ่งเช้าก่อนการรบ เปลกูซีเห็นเรือลำหนึ่งมีนักบุญบอริสและเกลบ เจ้าชายผู้พลีชีพของรุส พายมาช่วย «ญาติของเรา อเล็กซานเดอร์» — เรื่องเล่าที่บอกว่าคนยุคนั้นมองสงครามนี้เป็นสงครามศาสนา","src":"ผู้เรียบเรียง (Житие Александра Невского)"},{"d":2,"key":1,"at":[31.275,58.525],"h":"อเล็กซานเดอร์ยกทัพทันทีด้วยกำลังเล็ก","ru":"Александр Ярославич — «Не в силе Бог, а в правде»","tx":"อเล็กซานเดอร์ไม่รอกำลังจากบิดาที่เมืองวลาดีมีร์ รับพรจากอาร์ชบิชอปสปิริดอนที่มหาวิหารโซเฟีย แล้วยกดรูจินา <span class=\"vhm-ru\">(дружина)</span> ของตนกับชาวนอฟโกรอดออกเดินทัพทันที","more":"ตาม «ชีวประวัติ» เขากล่าวกับทหารว่า «พระเจ้าไม่ได้อยู่ที่กำลัง แต่อยู่ที่ความถูกต้อง» <span class=\"vhm-ru\">(«Не в силе Бог, а в правде»)</span> — วลีที่คนรัสเซียรู้จักทุกคน","src":"ผู้เรียบเรียง (ru.wikipedia)"},{"d":2.9,"at":[32.292,60.001],"h":"ผ่านลาโดกา ชาวลาโดกาสมทบ","ru":"марш вдоль Волхова через Ладогу","tx":"กองทัพเดินทัพเลียบแม่น้ำวอลคอฟขึ้นเหนือถึงเมืองลาโดกา ชาวลาโดกาเข้าร่วม แล้วเลี้ยวไปทางตะวันตกเข้าหาปากแม่น้ำอิจอราอย่างเงียบ ๆ ข้าศึกไม่รู้ตัว","more":"ความเร็วและการปกปิด = ความจู่โจม <span class=\"vhm-ru\">(внезапность)</span> ข้อ 10 ของ «พื้นฐานชัยชนะในการรบ» จากบรรยายที่ 1","src":"ผู้เรียบเรียง"},{"d":4.05,"key":1,"at":[30.612,59.8025],"h":"15 กรกฎาคม: จู่โจมค่ายสวีเดน","ru":"внезапный удар 15 июля 1240 года","tx":"ทหารรุสโผล่ออกมาจากทางตะวันออกโดยข้าศึกไม่ทันตั้งตัว ดรูจินาม้าของอเล็กซานเดอร์พุ่งเข้ากลางค่าย ชาวนอฟโกรอดเดินเท้าไล่ตามริมฝั่งเพื่อตัดข้าศึกออกจากเรือ ชาวลาโดกาตีจากทางใต้","more":"แบบจำลองของนักประวัติศาสตร์คีร์ปิชนิคอฟ: ฝ่ายรุสมีอย่างน้อย 3 กองของชาวนอฟโกรอดชั้นสูง + กองลาโดกา + ดรูจินาของเจ้าชาย","src":"สไลด์ 13 · แบบจำลอง: ผู้เรียบเรียง"},{"d":4.4,"fun":1,"at":[30.614,59.8023],"h":"«ประทับตราไว้บนใบหน้า»","ru":"«возложил печать на лицо» предводителю шведов","tx":"ชีวประวัติเล่าว่าอเล็กซานเดอร์บุกเข้าหาผู้นำสวีเดนด้วยตนเอง แล้วใช้หอก «ประทับตราไว้บนใบหน้า» ของเขา คือแทงเป็นแผลที่หน้า","src":"ผู้เรียบเรียง (Житие)"},{"d":5,"fun":1,"at":[30.608,59.805],"h":"กัฟรีโล โอเล็กซิชขี่ม้าขึ้นสะพานเรือ","ru":"подвиг Гаврилы Олексича","tx":"ชีวประวัติยกย่องนักรบ 6 คน คนแรกคือกัฟรีโล โอเล็กซิช <span class=\"vhm-ru\">(Гаврило Олексич)</span> ไล่ตามข้าศึกขึ้นสะพานไม้ถึงบนเรือทั้งที่ยังอยู่บนหลังม้า ถูกผลักตกน้ำพร้อมม้า แต่ขึ้นฝั่งได้แล้วกลับเข้ารบอีก ซบึยสลาฟ ยากูโนวิชสู้ด้วยขวานเล่มเดียว ยาคอฟ โปโลชานินสู้ด้วยดาบยาว","src":"ผู้เรียบเรียง (ru.wikipedia «Невская битва»)"},{"d":5.4,"fun":1,"at":[30.6128,59.8012],"h":"ซาฟวาโค่นกระโจมยอดทอง มิชาจมเรือ 3 ลำ","ru":"Савва, Миша, Ратмир","tx":"ทหารหนุ่มซาฟวา <span class=\"vhm-ru\">(Савва)</span> ฟันเสากระโจมยอดทองของผู้นำสวีเดนจนล้ม ทหารรุสเห็นแล้วฮึกเหิม มิชา <span class=\"vhm-ru\">(Миша)</span> ชาวนอฟโกรอดนำทหารเดินเท้าจมเรือข้าศึก 3 ลำ ส่วนรัตมีร์ <span class=\"vhm-ru\">(Ратмир)</span> ผู้รับใช้ของเจ้าชายสู้จนเสียชีวิต","src":"ผู้เรียบเรียง (ru.wikipedia)"},{"d":6,"at":[30.607,59.804],"h":"รบจนค่ำ สวีเดนถูกดันกลับไปที่เรือ","ru":"бой до вечера","tx":"การรบดำเนินไปจนค่ำ ฝ่ายสวีเดนถูกดันออกจากค่ายไปรวมอยู่ริมน้ำรอบเรือของตน แต่ยังไม่แตกหนี","src":"ผู้เรียบเรียง"},{"d":7,"key":1,"at":[30.595,59.809],"h":"กลางคืน: สวีเดนขนศพลงเรือแล้วถอย","ru":"шведы уходят; потери русских — до 20 «мужей»","tx":"คืนนั้นฝ่ายสวีเดนขนศพคนชั้นสูงลงเรือ 2 ลำแล้วปล่อยล่องออกทะเล ศพที่เหลือฝังในหลุมใหญ่ แล้วถอนตัวไปก่อนรุ่งสาง ฝ่ายรุสตามพงศาวดารเสียชีวิตไม่เกิน 20 «บุรุษ» ชนชั้นสูง","warn":"สไลด์ 13 ให้ตัวเลข «шведы 5000 чел., 100 кораблей, потери 600» และ «русские менее 1500, потери 20» — พงศาวดารนอฟโกรอดไม่ได้ให้จำนวนกำลังพลของทั้งสองฝ่ายเลย และ «20» ในพงศาวดารคือคนชั้นสูงที่ตายเท่านั้น ไม่นับบริวารของพวกเขา (ru.wikipedia «Невская битва»)","src":"สไลด์ 13 · ผู้เรียบเรียง"},{"d":8,"key":1,"at":[30.605,59.8045],"h":"ชัยชนะที่มาของฉายา «เนฟสกี»","ru":"Невская битва 15 июля 1240 г. — Александр Невский","tx":"สวีเดนเลิกคิดรุกเข้าลาโดกาและนอฟโกรอด และไม่สามารถประสานกับคณะอัศวินที่กำลังรุกทางตะวันตก แต่หลังชัยชนะ โบยาร์นอฟโกรอดทะเลาะกับอเล็กซานเดอร์จนเขาต้องออกจากเมือง ปีต่อมาเมื่ออัศวินเยอรมันบุกมาถึงใกล้นอฟโกรอด ชาวเมืองจึงต้องเชิญเขากลับมา — นำไปสู่ยุทธการบนน้ำแข็ง 1242","more":"ฉายา «เนฟสกี» (แห่งแม่น้ำเนวา) ปรากฏในพงศาวดารศตวรรษที่ 15 ไม่ใช่ในช่วงชีวิตของเขา","intl":"นักประวัติศาสตร์ตะวันตกบางคน (เจ. เฟนเนลล์, เจ. ลินด์) เห็นว่าอาจเป็นเพียงการปะทะชายแดนขนาดเล็กที่ถูกยกย่องเกินจริงด้วยเหตุผลทางการเมือง เพราะแหล่งข้อมูลสวีเดน รวมทั้ง «พงศาวดารของเอริก» ไม่เอ่ยถึงการรบนี้เลย","src":"สไลด์ 13 · ผู้เรียบเรียง (ru/en.wikipedia)"},{"d":8.6,"fun":1,"at":[30.388,59.921],"h":"อารามที่สร้างผิดที่","ru":"Александро-Невская лавра (1710)","tx":"ปี 1710 ปีเตอร์มหาราชสร้างอาราม (ต่อมาคืออเล็กซานโดร-เนฟสกี ลาฟรา) ในเซนต์ปีเตอร์สเบิร์ก เพราะเชื่อว่าการรบเกิดที่นั่น แต่จริง ๆ อยู่ที่ปากอิจอรา ห่างไปราว 18 กม. ปี 1724 ร่างของอเล็กซานเดอร์ถูกย้ายมาจากวลาดีมีร์ ส่วนหอระฆังของโบสถ์ที่อุสต์-อิจอราถูกระเบิดทิ้งช่วงปิดล้อมเลนินกราด เพราะปืนใหญ่เยอรมันใช้เป็นจุดเล็ง","src":"ผู้เรียบเรียง (ru.wikipedia «Невская битва»)"}]}