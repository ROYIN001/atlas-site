วันตกรุกถึงชายแดนเยอรมนีแต่ขาดเสบียง แนวหน้าในป่าอาร์แดนน์ <span class=\"vhm-ru\">(Арденны)</span> ของเบลเยียมและลักเซมเบิร์กมีทหารอเมริกันเพียงไม่กี่กองพล — บางกองพลเพิ่งมาจากสหรัฐฯ บางกองพลมาพักฟื้น</p><p>ฮิตเลอร์รวบรวมกองหนุนสุดท้ายอย่างลับ ๆ แผน «เฝ้ายามบนแม่น้ำไรน์» <span class=\"vhm-ru\">(«Вахта на Рейне»)</span>: เจาะแนวในป่า ข้ามแม่น้ำเมิส <span class=\"vhm-ru\">(Маас)</span> แล้วยึดท่าเรือแอนต์เวิร์ป แยกกองทัพอังกฤษออกจากกองทัพอเมริกัน — หวังให้ฝ่ายสัมพันธมิตรยอมเจรจาสันติภาพแยกต่างหาก กด ▶ เพื่อเริ่ม</p><div class=\"vhm-more\">สไลด์บรรยายที่ 13 ไม่มีหัวข้อนี้ แต่ต้องรู้เพราะเชื่อมกับปฏิบัติการวิสตูลา–โอเดอร์ (ดูเหตุการณ์ 6 และ 12 ม.ค.) และแผนที่ย่อมุมขวาบน (ผู้เรียบเรียง)</div>","tables":[{"title":"กำลังและความสูญเสีย (ผู้เรียบเรียง — สไลด์ไม่มีข้อมูล)","open":true,"head":["","สหรัฐฯ และอังกฤษ","เยอรมนี"],"rows":[["กำลังพลตอนเริ่ม (16.12, Dupuy)","228 741 (สหรัฐฯ), รถถัง 483","240 000–500 000 (ต่างกันตามแหล่ง)"],["กำลังพลสูงสุด","≈ 705 000 (2.01) · 840 000 (ru.wiki)","รถถัง ≈ 1 800 (ru.wiki)"],["ความสูญเสีย","สหรัฐฯ 89 500–108 350 · อังกฤษ ≈ 1 400","60 000–125 000"],["ยุทโธปกรณ์ที่เยอรมันเสีย","—","รถถังและปืนจู่โจม ≈ 600 · เครื่องบิน ≈ 1 600"]],"note":"ที่มา: ru.wikipedia «Арденнская операция (1944—1945)»; en.wikipedia «Battle of the Bulge» — ตัวเลขฝ่ายเยอรมันต่างกันมากตามแหล่ง"}],"events":[{"d":0.05,"key":1,"at":[6.2,50.3],"h":"เยอรมันบุกผ่านป่าอาร์แดนน์","ru":"16 декабря 1944 — начало Арденнского наступления вермахта: 6-я танковая армия СС, 5-я танковая армия, 7-я армия","tx":"เช้ามืดวันที่ 16 ธ.ค. สามกองทัพเยอรมันภายใต้กลุ่มกองทัพ «B» ของจอมพลโมเดลตีแนวอเมริกันที่บางเบาในป่าอาร์แดนน์ อากาศเลว หมอกและหิมะทำให้เครื่องบินฝ่ายสัมพันธมิตรขึ้นบินไม่ได้หลายวัน — ซึ่งเป็นสิ่งที่ฮิตเลอร์ตั้งใจรอ","more":"ป่าอาร์แดนน์เป็นเส้นทางเดียวกับที่เยอรมันใช้บุกฝรั่งเศสในเดือนพฤษภาคม 1940 (ดูแผนที่ «ฝรั่งเศส 1940»)","src":"ผู้เรียบเรียง (ru/en.wikipedia)"},{"d":0.6,"fun":1,"at":[5.86,50.49],"h":"ทหารเยอรมันในเครื่องแบบอเมริกัน","ru":"операция «Грайф» (Скорцени)","tx":"หน่วยพิเศษของสกอร์เซนี <span class=\"vhm-ru\">(Скорцени)</span> ใส่เครื่องแบบอเมริกันและพูดอังกฤษได้ แทรกซึมหลังแนวเพื่อก่อความสับสน ทหารอเมริกันจึงตั้งด่านถามคำถามเรื่องเบสบอลหรือเมืองหลวงของรัฐต่าง ๆ — แม้แต่นายพลแบรดลีย์เองก็เล่าว่าถูกด่านหยุดถาม","src":"ผู้เรียบเรียง (en.wikipedia «Operation Greif»)"},{"d":1.2,"at":[6.06,50.41],"when":"17.12.1944","h":"การสังหารเชลยที่มัลเมดี","ru":"17.12 — расстрел американских пленных у Мальмеди (боевая группа Пайпера)","tx":"หน่วยรบของพันโทไพเพอร์ <span class=\"vhm-ru\">(Пайпер)</span> จากกองพลยานเกราะ SS ที่ 1 ยิงเชลยอเมริกันที่ยอมแพ้แล้วราว 80 คนที่ทางแยกใกล้มัลเมดี ข่าวนี้ทำให้ทหารอเมริกันสู้อย่างดุเดือดขึ้น หลังสงครามผู้เกี่ยวข้องถูกนำตัวขึ้นศาลอาชญากรสงคราม","src":"ผู้เรียบเรียง (ru.wikipedia; en.wikipedia «Malmedy massacre»)"},{"d":3,"at":[6.13,50.28],"h":"«ไหล่เหนือ» ไม่ยอมถอย","ru":"17–21.12 — оборона Сен-Вита; «северное плечо» у Эльзенборна держится","tx":"ทางเหนือ ทหารอเมริกันยึดสันเขาเอลเซนบอร์นไว้ได้ ทำให้กองทัพยานเกราะ SS ที่ 6 ไม่อาจขยายช่องไปทางลีแยฌ หน่วยของไพเพอร์บุกลึกถึงสตูมงต์แล้วติดอยู่เพราะหมดน้ำมัน ส่วนเมืองแซ็ง-วิทยืนได้ถึง 21.12 — เยอรมันเสียเวลาไปหลายวันซึ่งมีค่าที่สุดในแผนนี้","src":"ผู้เรียบเรียง"},{"d":4.8,"key":1,"at":[5.72,50],"h":"บาสโตญถูกล้อม","ru":"20–21.12 — окружение Бастони: 101-я воздушно-десантная дивизия США","tx":"บาสโตญ <span class=\"vhm-ru\">(Бастонь)</span> เป็นชุมทางถนนเจ็ดสายกลางป่า ใครยึดได้ก็คุมการเดินทัพของทั้งภูมิภาค กองพลพลร่มที่ 101 ของสหรัฐฯ ถูกส่งมาด้วยรถบรรทุกทันเวลาพอดี แล้วถูกล้อมรอบด้าน — ทหารขาดกระสุน ยา และเสื้อผ้ากันหนาว","src":"ผู้เรียบเรียง (ru.wikipedia)"},{"d":6,"fun":1,"at":[5.72,50],"when":"22.12.1944","h":"«ถั่ว!» — คำตอบสั้นที่สุด","ru":"ответ генерала Маколиффа на ультиматум: «Nuts!» («Чушь!»)","tx":"เยอรมันส่งหนังสือเรียกให้ยอมแพ้ นายพลแม็กออลิฟฟ์ <span class=\"vhm-ru\">(Маколифф)</span> ผู้บัญชาการในบาสโตญตอบเพียงคำเดียวว่า «Nuts!» (ประมาณว่า «บ้าไปแล้ว!») ผู้ถือสารชาวเยอรมันไม่เข้าใจความหมายของสแลงนี้ ต้องมีคนอธิบายว่าแปลว่า «ไปลงนรกซะ»","src":"ผู้เรียบเรียง (en.wikipedia «Siege of Bastogne»)"},{"d":7,"at":[5.72,50],"when":"23.12.1944","h":"ท้องฟ้าเปิด — เครื่องบินกลับมา","ru":"23.12 — улучшение погоды: авиация союзников, снабжение Бастони по воздуху","tx":"เมื่ออากาศดีขึ้น เครื่องบินฝ่ายสัมพันธมิตรหลายพันเที่ยวโจมตีขบวนรถเยอรมันและทิ้งเสบียงให้บาสโตญ ขบวนเยอรมันที่ติดอยู่บนถนนแคบในป่ากลายเป็นเป้าง่าย และขาดน้ำมันมากขึ้นทุกวัน","src":"ผู้เรียบเรียง"},{"d":8.7,"key":1,"at":[5.01,50.23],"h":"จุดที่ไกลที่สุด — ไม่ถึงแม่น้ำเมิส","ru":"24–25.12 — максимальное продвижение: 2-я танковая дивизия вермахта у Селя, в нескольких км от Мааса у Динана","tx":"หัวหอกของกองพลยานเกราะที่ 2 ของเยอรมันมาถึงหมู่บ้านแซล ห่างแม่น้ำเมิสที่ดีน็องเพียงไม่กี่กิโลเมตร แล้วหมดน้ำมัน กองพลยานเกราะที่ 2 ของสหรัฐฯ ตีทำลายได้ในวันคริสต์มาส ส่วนกองทัพน้อยที่ 30 ของอังกฤษเฝ้าสะพานบนแม่น้ำเมิสไว้ «ส่วนยื่น» ลึกราว 80–90 กม. แต่แผนไปแอนต์เวิร์ปล้มเหลวแล้ว","src":"ผู้เรียบเรียง (ระยะทางคำนวณจากแผนที่)"},{"d":10,"key":1,"at":[5.72,49.95],"h":"แพตตันช่วยบาสโตญ","ru":"26.12 — 3-я армия США (Паттон) деблокировала Бастонь","tx":"แพตตันหันกองทัพที่ 3 จากแนวซาร์ขึ้นเหนือเกือบ 90 องศาภายในไม่กี่วัน — งานเดินทัพที่ยากมากในฤดูหนาว รถถังของกองพลยานเกราะที่ 4 เจาะวงล้อมเข้าบาสโตญได้ตอนเย็นวันที่ 26 ธ.ค.","src":"ผู้เรียบเรียง (ru.wikipedia «контрудар 3-й американской армии в направлении Бастони»)"},{"d":16,"at":[6.5,50.8],"when":"1.01.1945","h":"การโจมตีทางอากาศครั้งสุดท้ายของลุฟท์วัฟเฟอ","ru":"1.01.1945 — удар люфтваффе по аэродромам («Боденплатте»); наступление «Нордвинд» в Эльзасе","tx":"เช้าวันปีใหม่ เครื่องบินเยอรมันราวพันลำโจมตีสนามบินฝ่ายสัมพันธมิตรในเบลเยียมและเนเธอร์แลนด์ ทำลายเครื่องบินได้หลายร้อยลำ แต่เยอรมันเสียนักบินที่หาทดแทนไม่ได้ ส่วนหนึ่งถูกปืนต่อสู้อากาศยานของเยอรมันเองยิงตก เพราะปฏิบัติการเป็นความลับจนหน่วยปืนไม่ได้รับแจ้ง ในวันเดียวกัน เยอรมันเปิดการรุก «ลมเหนือ» ในแคว้นอาลซัส","src":"ผู้เรียบเรียง (en.wikipedia «Operation Bodenplatte», «Operation Nordwind»)"},{"d":21,"key":1,"when":"6–7.01.1945","h":"จดหมายของเชอร์ชิลล์ถึงสตาลิน","ru":"6 января 1