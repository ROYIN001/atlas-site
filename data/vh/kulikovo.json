สเซีย (БРЭ, อ. คุซมิน)","≈20 000","—"],["บูลึชเยฟ, ดวูเรเชนสกี","6 000–10 000 (≈8 000)","6 000–10 000 (≈7 000)"],["en.wikipedia","15 000–20 000","ไม่เกิน 30 000"],["ความสูญเสียรุส: ราซิน / คีร์ปิชนิคอฟ / อูร์ลานิส","25–30 พัน / ≈800 ขุนนาง + 5–8 พัน / ≈10 000","—"]],"note":"สไลด์เขียนตัวเลขสองชุดโดยไม่บอกฝ่าย «36 тыс.» ตรงกับค่าสูงสุดที่คีร์ปิชนิคอฟประเมินให้ฝ่ายรุส — ในห้องสอบให้ระบุฝ่ายให้ชัด (ผู้เรียบเรียง: ru/en.wikipedia)"},{"title":"รูปขบวนรบของรุส: กรมและแม่ทัพ (боевой порядок)","head":["กรม (полк)","แม่ทัพ (воеводы)"],"rows":[["กรมยาม (сторожевой)","Семён Оболенский, Иван Тарусский"],["กรมหน้า (передовой)","князья Друцкие"],["กรมใหญ่ (большой) — ตรงกลาง","Тимофей Вельяминов; под знаменем — Михаил Бренок"],["กรมปีกขวา (правой руки)","Андрей Ольгердович"],["กรมปีกซ้าย (левой руки)","Василий Ярославский, Фёдор Моложский"],["กองหนุน (резерв)","Дмитрий Ольгердович"],["กรมซุ่ม (засадный)","Владимир Андреевич Серпуховской, Дмитрий Боброк-Волынский"]],"note":"ผู้เรียบเรียง: ru.wikipedia «Куликовская битва» — เทียบกับ «полчный ряд» ของนอฟโกรอดในสไลด์ 12 ซึ่งมีกรมซุ่มอยู่แล้ว"}],"events":[{"d":0.05,"key":1,"at":[37.62,55.75],"h":"มอสโกระดมพล","ru":"Великий князь Дмитрий Иванович против Мамая","tx":"เมื่อรู้ว่ามาไมยกทัพมา ดมีตรีเรียกกรมจากเมืองต่าง ๆ ของรุสตะวันออกเฉียงเหนือมารวมกัน กองทัพออกจากมอสโกไปทางใต้สู่โคลอมนา <span class=\"vhm-ru\">(Коломна)</span> บนแม่น้ำโอคา ซึ่งเป็นชายแดนด้านทุ่งหญ้าสเตปป์","src":"ผู้เรียบเรียง (ru.wikipedia «Куликовская битва»)"},{"d":0.6,"key":1,"at":[38.78,55.08],"h":"15 สิงหาคม: รวมพลที่โคลอมนา","ru":"сбор войск в Коломне","tx":"ที่โคลอมนากองทัพจัดรูปขบวนเป็นครั้งแรกและแบ่งเป็นกรม <span class=\"vhm-ru\">(полки)</span> พร้อมแต่งตั้งแม่ทัพของแต่ละกรม","intl":"วันที่ต่างกันตามแหล่ง: ru.wikipedia ระบุรวมพล 15 ส.ค. ส่วน en.wikipedia ระบุ 20 ส.ค.","src":"ผู้เรียบเรียง"},{"d":0.9,"fun":1,"h":"พรจากเซอร์กีย์แห่งราโดเนจ","ru":"Сергий Радонежский благословляет; Пересвет и Ослябя","tx":"ตามตำนาน «เรื่องเล่าการสังหารหมู่มาไม» <span class=\"vhm-ru\">(Сказание о Мамаевом побоище)</span> ก่อนออกศึกดมีตรีไปรับพรจากนักบุญเซอร์กีย์แห่งราโดเนจ ผู้ส่งนักบวชนักรบสองรูป คือเปเรสเวตและออสเลียเบีย ไปร่วมรบด้วย — ศาสนาเป็นแรงใจสำคัญของกองทัพ","src":"ผู้เรียบเรียง (ตำนาน — นักประวัติศาสตร์ยังถกเถียงรายละเอียด)"},{"d":1.4,"key":1,"at":[37.87,54.84],"h":"ข้ามโอคาที่ปากแม่น้ำโลปัสเนีย","ru":"переправа через Оку у устья Лопасни","tx":"แทนที่จะตั้งรับหลังแม่น้ำโอคาตามที่มาไมคาด ดมีตรีเดินทัพไปทางตะวันตกเลี่ยงดินแดนเรียซาน แล้วข้ามโอคาที่ปากแม่น้ำโลปัสเนีย <span class=\"vhm-ru\">(Лопасня)</span> มุ่งลงใต้เข้าหาข้าศึก — จากฝ่ายตั้งรับกลายเป็นฝ่ายรุก","more":"ความเร็วนี้มีเป้าหมายชัดเจน: ตีมาไม <b>ก่อน</b> ที่ยาไกลาจะมาสมทบ — ไม่ให้ข้าศึกรวมกำลังกันได้","src":"ผู้เรียบเรียง (ru/en.wikipedia)"},{"d":2.2,"at":[38.35,53.88],"h":"เจ้าชายลิทัวเนียสองพี่น้องมาสมทบ","ru":"Андрей и Дмитрий Ольгердовичи","tx":"ที่ตำบลเบเรซุย อันเดรย์และดมีตรี โอลเกร์โดวิช บุตรของแกรนด์ดยุกลิทัวเนียผู้ล่วงลับและพี่น้องต่างมารดาของยาไกลา นำกองทัพมาเข้ากับมอสโก — ลิทัวเนียเองก็แตกเป็นสองฝ่าย","src":"ผู้เรียบเรียง"},{"d":2.7,"at":[36.68,53.94],"h":"ยาไกลามาไม่ทัน โอเลกนั่งรอดูท่าที","ru":"Ягайло у Одоева; Олег Рязанский выжидает","tx":"กองทัพลิทัวเนียของยาไกลาเดินทัพมาถึงแถวเมืองโอโดเยฟแต่ไม่ทันการรบ ส่วนโอเลกแห่งเรียซานไม่ได้ส่งทัพมาช่วยมาไมจริง ดมีตรีจึงได้รบกับมาไมตามลำพัง","src":"ผู้เรียบเรียง (ru.wikipedia)"},{"d":3.1,"key":1,"at":[38.656,53.6735],"h":"7 กันยายน: ข้ามดอนแล้วรื้อสะพาน","ru":"переправа через Дон; мосты уничтожены","tx":"สภาแม่ทัพถกเถียงว่าจะข้ามแม่น้ำดอนหรือไม่ ดมีตรีตัดสินใจข้ามไปฝั่งเดียวกับมาไม แล้วสั่งรื้อสะพานทิ้ง: ไม่มีทางถอย ขณะเดียวกันแม่น้ำก็กันหลังจากลิทัวเนียและเรียซาน","more":"แม่น้ำดอนและเนปรยัดวาอยู่ข้างหลัง หุบห้วยและป่าคุ้มกันปีกทั้งสอง — ทหารม้าตาตาร์จึงวนโอบปีกแบบถนัดไม่ได้ ต้องตีตรงหน้า","src":"ผู้เรียบเรียง"},{"d":4.1,"key":1,"at":[38.666,53.652],"h":"จัดทัพ 7 ส่วน — ซ่อนกรมซุ่มไว้ในป่า","ru":"боевой порядок: сторожевой, передовой, большой полк, полки правой и левой руки, резерв, засадный полк","tx":"เย็นวันที่ 7 กรมต่าง ๆ ตั้งเรียงหันหน้าลงใต้: กรมยามและกรมหน้าอยู่ด้านหน้า กรมใหญ่ตรงกลาง กรมปีกขวาและปีกซ้ายสองข้าง กองหนุนอยู่หลังกรมใหญ่ และ <b>กรมซุ่ม</b> <span class=\"vhm-ru\">(засадный полк)</span> ของวลาดีมีร์ อันเดรเยวิช เซอร์ปูคอฟสกี กับดมีตรี โบบร็อก-โวลึนสกี ซ่อนอยู่ในป่าโอ๊กหลังปีกซ้าย","more":"ดูรายชื่อแม่ทัพทุกกรมในตารางใต้แผนที่ · ปีกซ้ายเป็นจุดอ่อนที่ตั้งใจ: ถ้าข้าศึกตีทะลุตรงนั้น มันจะหันหลังให้ป่าที่กรมซุ่มรออยู่","src":"ผู้เรียบเรียง (ru.wikipedia)"},{"d":5.1,"at":[38.666,53.63851],"h":"เช้า 8 กันยายน: หมอกหนา","ru":"туман до «третьего часа»","tx":"เช้าวันนั้นหมอกลงหนาจนมองไม่เห็นข้าศึก เมื่อหมอกจางกองทัพมาไมจึงปรากฏขึ้นทางใต้ ราว «ชั่วโมงที่ 6 ของวัน» ตามพงศาวดาร (en.wikipedia ประเมินราว 10:35 น.) มาไมตั้งกองบัญชาการบนเนินแดง <span class=\"vhm-ru\">(Красный холм)</span>","more":"ก่อนการรบดมีตรีแลกชุดเกราะกับบ่าวคนสนิท มีฮาอิล เบรน็อก <span class=\"vhm-ru\">(Михаил Бренок)</span> ให้ยืนใต้ธงใหญ่แทนตน แล้วตนเองไปรบในแถวหน้าเหมือนทหารธรรมดา","src":"ผู้เรียบเรียง (ru/en.wikipedia)"},{"d":5.5,"fun":1,"at":[38.666,53.64004],"h":"การดวลของเปเรสเวตกับเชลูเบย์","ru":"поединок Пересвета и Челубея","tx":"ตามตำนาน การรบเริ่มด้วยการดวลตัวต่อตัวระหว่างนักบวชนักรบอเล็กซานเดอร์ เปเรสเวต <span class=\"vhm-ru\">(Пересвет)</span> กับนักรบตาตาร์เชลูเบย์ <span class=\"vhm-ru\">(Челубей)</span> ทั้งสองแทงกันด้วยหอกและเสียชีวิตทั้งคู่","src":"ผู้เรียบเรียง (อาจเป็นตำนาน — ru.wikipedia)"},{"d":6.1,"key":1,"at":[38.666,53.6466],"h":"ปะทะใหญ่: กรมยามและกรมหน้าถูกบดขยี้","ru":"бой сторожевого и передового полков с авангардом Теляка","tx":"กองหน้าตาตาร์ของเตลยัก <span class=\"vhm-ru\">(Теляк)</span> แล้วตามด้วยกองทัพหลักพุ่งเข้าใส่ กรมยามและกรมหน้าของรุสสู้จนเกือบหมด แล้วการรบก็กลายเป็นการตะลุมบอนตลอดแนวหน้า","src":"ผู้เรียบเรียง"},{"d":7.1,"key":1,"at":[38.67889,53.6565],"h":"วิกฤต: ปีกซ้ายแตก ธงใหญ่ล้ม","ru":"прорыв левого фланга; пало великокняжеское знамя, погиб Бренок","tx":"หลังรบกันราวสามชั่วโมง ตาตาร์ตีปีกซ้ายของรุสแตกและดันขึ้นเหนือเข้าหาแม่น้ำ ธงใหญ่ของกรมกลางล้ม เบรน็อกที่ยืนใต้ธงในชุดของดมีตรีถูกสังหาร กองหนุนของดมีตรี โอลเกร์โดวิชเข้าอุดช่องโหว่ไว้ได้","more":"ผู้บังคับกรมซุ่มเห็นทหารฝ่ายตนตายแต่ยังไม่ออกตี ตามตำนาน โบบร็อกห้ามวลาดีมีร์ อันเดรเยวิชที่ร้อนใจว่า «ยังไม่ถึงเวลา» — รอจนข้าศึกหันหลังให้","src":"ผู้เรียบเรียง (ru.wikipedia)"},{"d":8,"key":1,"at":[38.68722,53.65758],"h":"กรมซุ่มออกตี!","ru":"удар засадного полка (Владимир Андреевич Серпуховской, Дмитрий Боброк-Волынский)","tx":"เมื่อปีกขวาของตาตาร์ไล่ตามผ่านป่าไปแล้วและหันหลังให้ป่า โบบร็อกจึงสั่ง «ถึงเวลาแล้ว» ทหารม้าสดของกรมซุ่มพุ่งออกจากป่าตีด้านหลังข้าศึก ตาตาร์ตกใจคิดว่ามีกองทัพใหม่มาถึงและเริ่มแตก พร้อมกันนั้นกรมปีกขวาของอันเดรย์ โอลเกร์โดวิชก็เข้าตีด้วย","more":"เทียบกับฟาร์ซาล (บรรยายที่ 1): กองหนุนที่ซ่อนไว้และทุ่มลงใน <b>เวลาที่ถูกต้อง</b> ตัดสินผลของยุทธการ — กรมซุ่มคือจุดเด่นของศิลปะการนำทัพของดมีตรี ดอนสกอย","src":"ผู้เรียบเรียง"},{"d":9,"key":1,"at":[38.672,53.624],"h":"มาไมหนี — ไล่ตาม 50 เวิร์สต์","ru":"бегство Мамая; преследование до реки Красивая Меча","tx":"ทั้งกองทัพมาไมแตกพ่าย มาไมหนีจากเนินแดง ทหารรุสไล่ตามราว 50 เวิร์สต์ถึงแม่น้ำคราซีวายาเมชา <span class=\"vhm-ru\">(Красивая Меча)</span> ส่วนดมีตรีบาดเจ็บ ทหารพบเขาหมดสติอยู่ใต้ต้นเบิร์ชที่ถูกโค่น","src":"ผู้เรียบเรียง (ru/en.wikipedia)"},{"d":9.4,"fun":1,"h":"สนามรบที่ไม่มีหลุมศพ","ru":"археология Куликова поля","tx":"นักโบราณคดีหาหลุมศพทหารที่คูลิโคโวไม่พบเป็นเวลานาน ปี 2006 เรดาร์หยั่งดินพบวัตถุ 6 จุดเรียงจากตะวันตกไปตะวันออก ห่างกัน 100–120 ม. ซึ่งอาจเป็นหลุมศพ ส่วนดินดำ <span class=\"vhm-ru\">(чернозём)</span> อาจย่อยสลายกระดูกไปหมดแล้ว","src":"ผู้เรียบเรียง (ru.wikipedia)"},{"d":9.85,"key":1,"at":[38.666,53.6493],"h":"ผล: มอสโกนำรุส — แต่แอกยังไม่สิ้น","ru":"8 (21) сентября 1380 г. — День воинской славы России","tx":"ชัยชนะทำให้มอสโกได้รับการยอมรับว่าเป็นผู้นำในการรวมดินแดนรุส และดมีตรีได้รับฉายาภายหลังว่า «ดอนสกอย» (แห่งแม่น้ำดอน) แต่แอกตาตาร์-มองโกลยังไม่จบ: ปี 1382 ข่านต็อคตามึชเผามอสโก และแอกสิ้นสุดจริงหลัง «การเผชิญหน้าที่แม่น้ำอูกรา» ปี 1480","warn":"สไลด์ 20 ใช้วันที่ «8 (21) сентября» ตามกฎหมายวันเกียรติยศทางทหาร แต่ถ้าแปลงเป็นปฏิทินเกรกอเรียนตามหลักวิชาการ ศตวรรษที่ 14 ต่างกัน 8 วัน คือ <b>16 กันยายน</b> · ตัวเลข «36–80 тысяч» และ «100–120 тысяч» บนสไลด์ไม่ได้ระบุฝ่าย","intl":"ตำราดั้งเดิมให้รุส 100–150 พันคน การประเมินรัสเซียสมัยใหม่เหลือ 6–20 พัน สารานุกรมตะวันตกให้รุส 15–20 พันและมาไมไม่เกิน 30 พัน นักประวัติศาสตร์ตะวันตกเน้นว่าการรบไม่ได้ปลดแอก ส่วนตำรารัสเซียเน้นว่าเป็น «จุดเริ่มของการรวมชาติ»","src":"สไลด์ 20 · ผู้เรียบเรียง"}]}