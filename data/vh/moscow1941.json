49.5],[38.3,48.2],[38.9,47.3]],"from":50}],"arrows":[{"side":"su","d0":58,"d1":61,"pts":[[40.6,47.7],[40.1,47.4],[39.7,47.25]]},{"side":"su","d0":67,"d1":71,"pts":[[34.2,59.4],[33.8,59.6],[33.5,59.65]]}],"cities":[{"n":"Ленинград","ll":[30.32,59.94]},{"n":"Ростов","ll":[39.7,47.23],"al":"right"}]},"intro":"<div class=\"vhm-ch\"><span class=\"vhm-cd\">กันยายน 1941</span></div><b>ปฏิบัติการ «ไต้ฝุ่น» — ยึดมอสโกก่อนฤดูหนาว</b><p>หลังชนะที่เคียฟ เยอรมนีรวมกำลังเกือบครึ่งหนึ่งของแนวรบตะวันออกไว้ที่กลุ่มกองทัพ «กลาง» ของบ็อค แผนคือ 3 การโจมตีใหญ่จากเขตดูคอฟชีนา รอสลัฟล์ และช็อสท์คา เพื่อเจาะแนว ล้อม และทำลายกองทัพโซเวียตที่วยาซมาและบรียันสค์ แล้วเปิดทางสู่มอสโก ทั้งกลุ่มรถถังที่ 2 ของกูเดเรียน และกลุ่มรถถังที่ 4 ของเฮิพเนอร์ที่ย้ายมาจากทางเหนือ ถูกรวมไว้ที่นี่ กด ▶ เพื่อเริ่ม</p><div class=\"vhm-more\">สไลด์ 14: ดุลกำลัง เยอรมนี / สหภาพโซเวียต — กองพล 74 / 95 · กำลังพล 1 800 000 / 1 250 000 · ปืนใหญ่และปืนครก >14 000 / 7 600 · รถถัง 1 700 / 1 044 · เครื่องบิน 1 390 / 677</div>","tables":[{"title":"ดุลกำลังก่อนยุทธการมอสโก (สไลด์ 14)","open":true,"head":["","Германия","СССР"],"rows":[["กองพล (дивизии)","74","95"],["กำลังพล (личный состав)","1 800 000","1 250 000"],["ปืนใหญ่และปืนครก","свыше 14 000","7 600"],["รถถัง (танки)","1 700","1 044"],["เครื่องบิน (самолёты)","1 390","677"]],"note":"แหล่งอื่นให้รถถังฝ่ายโซเวียตตั้งแต่ 990 ถึง 3 232 คัน ขึ้นกับวิธีนับ (ผู้เรียบเรียง: en.wikipedia «Battle of Moscow»)"},{"title":"ความสูญเสีย","head":["","สไลด์ 16","แหล่งอื่น ¹"],"rows":[["Германия","153 000","ตาย 35 757 · เจ็บ 128 716 · หาย 9 721 (1.10.41–10.01.42)"],["СССР — ขั้นตั้งรับ","514 000","สูญเสียถาวร 514 338 (30.09–5.12)"],["СССР — ขั้นรุกโต้ตอบ","—","ถาวร 139 586 · เจ็บ/ป่วย 231 369 (5.12–7.01)"]],"note":"¹ ผู้เรียบเรียง: รายงานประจำวันของกองทัพเยอรมัน และคริโวเชเยฟ (Кривошеев; en.wikipedia «Battle of Moscow») — ตัวเลข 514 000 ในสไลด์คือเฉพาะความสูญเสียถาวรของขั้นตั้งรับ"}],"events":[{"d":0.05,"key":1,"at":[33.9,51.95],"h":"«ไต้ฝุ่น» เริ่มจากทางใต้","ru":"операция «Тайфун»: 30.09.1941 — наступление 2-й танковой группы Гудериана на Орловском направлении","tx":"กลุ่มรถถังที่ 2 ของกูเดเรียน (ต่อมาเป็นกองทัพรถถังที่ 2) และกองทัพที่ 2 ของไวคส์เริ่มรุกในทิศโอริออลก่อนกำลังหลักสองวัน เพื่ออ้อมปีกใต้ของแนวรบบรียันสค์","warn":"สไลด์ 13 เขียนว่า «15 сентября 1941 года… фон Браухич представил план» — พื้นฐานของไต้ฝุ่นคือคำสั่งฮิตเลอร์ที่ 35 ลงวันที่ 6.09.1941 และคำสั่งของกลุ่มกองทัพ «กลาง» เรื่องการเตรียมปฏิบัติการ «ไต้ฝุ่น» ลงวันที่ 16.09.1941 — วันที่ 15.09 ของสไลด์ใกล้เคียงกัน ในห้องสอบพูดตามสไลด์ได้ (ผู้เรียบเรียง: docs.historyrussia.org; en.wikipedia «Battle of Vyazma–Bryansk»)","src":"สไลด์ 13, 15 · ผู้เรียบเรียง"},{"d":2,"key":1,"at":[33.3,55.4],"h":"กำลังหลักเข้าตี — เจาะแนวสองจุด","ru":"2.10 — наступление 4-й армии на шоссе Рославль – Москва, 3-й танковой группы на Холм – Москва","tx":"กลุ่มรถถังที่ 3 (โกท) ตีจากดูคอฟชีนา และกลุ่มรถถังที่ 4 (เฮิพเนอร์) กับกองทัพที่ 4 ตีจากรอสลัฟล์ ตามทางหลวงสู่มอสโก ทั้งสองเจาะแนวแนวรบตะวันตก (โคเนฟ) และแนวรบสำรอง (บูดิออนนืย) ได้ในวันแรก แล้วเลี้ยวเข้าหากันที่วยาซมา","more":"«Холм» ในสไลด์ 15 น่าจะหมายถึงโฮล์ม-ซีร์คอฟสกี้ <span class=\"vhm-ru\">(Холм-Жирковский)</span> ทางเหนือของวยาซมา ไม่ใช่เมืองโฮล์มในแคว้นนอฟโกรอด (ผู้เรียบเรียง — ยังยืนยันไม่ได้)","src":"สไลด์ 15 · ผู้เรียบเรียง"},{"d":3,"fun":1,"at":[36.08,52.97],"h":"โอริออลแตก — รถรางยังวิ่งอยู่","ru":"3 октября — захвачен Орёл","tx":"รถถังของกูเดเรียนเข้าเมืองโอริออลเร็วจนเมืองยังไม่ทันรู้ตัว ตามบันทึกของกูเดเรียน รถรางในเมืองยังวิ่งอยู่ตามปกติ และโรงงานยังไม่ทันถูกอพยพ ไม่กี่วันต่อมากองพลน้อยรถถังของคาตูคอฟ <span class=\"vhm-ru\">(М.Е. Катуков)</span> ใช้การซุ่มโจมตีด้วยรถถัง Т-34 หยุดเยอรมันที่มเซนสค์ไว้ได้หลายวัน","src":"ผู้เรียบเรียง"},{"d":7,"key":1,"at":[34.3,55.21],"h":"วงล้อมวยาซมาและบรียันสค์","ru":"в окружение под Вязьмой и Брянском попали 663 тыс. чел. (слайд 15)","tx":"7 ตุลาคม ก้ามปูของกลุ่มรถถังที่ 3 และ 4 ปิดที่วยาซมา ล้อมกองทัพที่ 19, 20, 24 และ 32 ขณะที่ทางใต้กองทัพที่ 3, 13 และ 50 ของแนวรบบรียันสค์ถูกล้อมเป็นสองกลุ่ม ทางสู่มอสโกเกือบว่างเปล่า แต่ทหารในวงล้อมสู้ต่อจนกลางเดือนตุลาคม ตรึงกำลังเยอรมันไว้ในช่วงเวลาสำคัญ","intl":"663 000 คือตัวเลขเชลยของฝ่ายเยอรมัน นักประวัติศาสตร์รัสเซียประเมินจำนวนผู้ติดวงล้อมตั้งแต่ราว 600 000 ถึงเกือบ 1 ล้านคน","src":"สไลด์ 15 · ผู้เรียบเรียง"},{"d":10,"key":1,"at":[36.03,55.5],"h":"จูคอฟรับแนวรบตะวันตก — แนวโมไซสค์","ru":"10 октября — Г.К. Жуков командующий Западным фронтом","tx":"สตาลินเรียกจูคอฟกลับจากเลนินกราด รวมแนวรบตะวันตกกับแนวรบสำรองให้เขาบัญชาการ แนวป้องกันโมไซสค์ <span class=\"vhm-ru\">(Можайская линия обороны)</span> ถูกเติมด้วยทุกหน่วยที่หาได้ รวมทั้งนักเรียนนายร้อยจากโรงเรียนทหาร เยอรมันยึดคาลูกา (13.10) คาลีนิน (14.10) โมไซสค์และมาโลยาโรสลาเวตส์ (18.10)","warn":"สไลด์ 14 ระบุ «Калининский ф.» ในรายชื่อแนวรบตั้งแต่ต้นยุทธการ — แนวรบคาลีนินตั้งขึ้นวันที่ 17.10.1941 (โคเนฟ) จากปีกขวาของแนวรบตะวันตก และจูคอฟบัญชาการแนวรบตะวันตกตั้งแต่ 10.10 (ผู้เรียบเรียง)","src":"สไลด์ 14–15 · ผู้เรียบเรียง"},{"d":19,"at":[37.62,55.75],"h":"มอสโกตกอยู่ในภาวะปิดล้อม","ru":"19–20 октября — в Москве введено осадное положение","tx":"กลางเดือนตุลาคมรัฐบาลและสถานทูตส่วนใหญ่อพยพไปเมืองคูยบืยเชฟ (ซามารา) ในเมืองเกิดความตื่นตระหนก แต่สตาลินอยู่ในมอสโก และประกาศภาวะปิดล้อม <span class=\"vhm-ru\">(осадное положение)</span> เพื่อฟื้นระเบียบ ชาวเมืองหลายแสนคนออกไปขุดคูต่อสู้รถถังรอบเมือง","src":"ผู้เรียบเรียง"},{"d":29,"key":1,"at":[37.62,54.19],"when":"ปลาย ต.ค. 1941","h":"ตูลายืนหยัด — ฤดูโคลนหยุดการรุก","ru":"немцы достигли окраин Тулы, Серпухова, заняли Наро-Фоминск, Волоколамск и Калинин","tx":"กูเดเรียนไปถึงชานเมืองตูลาแต่ยึดไม่ได้ กองทัพที่ 50 กองทหารเมือง และกรมกรรมกรอาสาสมัครป้องกันเมืองไว้ ฝนฤดูใบไม้ร่วงทำให้ถนนกลายเป็นโคลน <span class=\"vhm-ru\">(распутица)</span> การรุกของเยอรมันหยุดลงเกือบทั้งแนว ทั้งสองฝ่ายใช้เวลานี้เตรียมการรบรอบใหม่","src":"สไลด์ 15 · ผู้เรียบเรียง"},{"d":38,"fun":1,"at":[37.62,55.75],"h":"สวนสนามที่จัตุรัสแดง 7 พฤศจิกายน","ru":"парад на Красной площади 7 ноября 1941 г.","tx":"ขณะที่เยอรมันอยู่ห่างมอสโกไม่ถึง 100 กม. สตาลินยังจัดสวนสนามฉลองวันปฏิวัติตามประเพณี ทหารหลายหน่วยเดินจากจัตุรัสแดงตรงไปแนวหน้า ภาพยนตร์ข่าวของสวนสนามนี้ปลุกขวัญคนทั้งประเทศ","src":"ผู้เรียบเรียง"},{"d":46,"key":1,"at":[36.73,56.33],"h":"การรุกระลอกสอง — ปีกเหนือและปีกใต้","ru":"15.11 — новое наступление: на севере — на Клин и Рогачёво, на юге — на Каширу и Тулу","tx":"เมื่อพื้นดินแข็งตัว เยอรมันรุกอีกครั้งเพื่อโอบมอสโกจากสองปีก: กลุ่มรถถังที่ 3 และ 4 จากเหนือผ่านคลิน กองทัพรถถังที่ 2 จากใต้อ้อมตูลาไปทางคาชีรา","src":"สไลด์ 16 · ผู้เรียบเรียง"},{"d":59,"key":1,"at":[37.48,56.29],"when":"23–28.11.1941","h":"คลินแตก — แต่เยอรมันหยุด","ru":"Клин взят; 28.11 — немцы остановились","tx":"เยอรมันยึดคลิน โซลเนชโนกอร์สค์ และอิสตรา และข้ามคลองมอสโก–วอลกาที่ยาครอมา แต่กองทัพช็อกที่ 1 ตีกลับไป ทางใต้ทหารม้าของเบลอฟหยุดรถถังของกูเดเรียนไว้ก่อนถึงคาชีรา ตามสไลด์ 16 เยอรมันหยุดวันที่ 28 พฤศจิกายน","warn":"สไลด์ 16 เขียน «22.11 – взят Клин» — แหล่งส่วนใหญ่ระบุ 23.11.1941 (ผู้เรียบเรียง: en.wikipedia «Battle of Moscow»)","src":"สไลด์ 16 · ผู้เรียบเรียง"},{"d":63,"fun":1,"at":[37.43,56],"when":"ต้น ธ.ค. 1941","h":"ใกล้เครมลินเพียง 29 กม.","ru":"Красная Поляна, Химки — ближайшие к Москве точки","tx":"จุดที่เยอรมันเข้าใกล้มอสโกที่สุดคือหมู่บ้านกราสนายาโปเลียนา ราว 29 กม. จากเครมลิน และหน่วยลาดตระเวนที่คิมกีราว 30 กม. ปัจจุบันริมถนนสู่สนามบินเชเรเมเตียโวมีอนุสรณ์ «เม่นต่อสู้รถถัง» ขนาดใหญ่ตั้งอยู่","src":"ผู้เรียบเรียง"},{"d":66,"key":1,"at":[36.1,56.8],"h":"5 ธันวาคม: เริ่มการรุกโต้ตอบ","ru":"5 декабря 1941 г. — контрнаступление Калининского фронта (День воинской славы России)","tx":"ในอากาศหนาวติดลบกว่า 30 องศา แนวรบคาลีนินของโคเนฟเริ่มรุก วันที่ 5 ธันวาคมเป็นวันเกียรติยศทางทหารของรัสเซีย <span class=\"vhm-ru\">(ДВС)</span> แนวคิดของการรุก: ใช้การโจมตีของแนวรบทำลายกลุ่มข้าศึกทางเหนือและใต้ของมอสโก","src":"สไลด์ 16–17"},{"d":67,"key":1,"at":[37.2,56.2],"h":"6 ธันวาคม: แนวรบตะวันตกเข้าตี","ru":"6.12 — наступление Западного фронта; в районе Ельца — Юго-Западный фронт","tx":"กองทัพของจูคอฟตีทั้งปีกเหนือ (กองทัพที่ 30, ช็อกที่ 1, 20, 16) และปีกใต้ (กองทัพที่ 10, 50 และทหารม้าของเบลอฟ) ปีกขวาของแนวรบตะวันตกเฉียงใต้ของติโมเชนโคตีที่เยเลตส์ วันที่ 8 ธันวาคมฮิตเลอร์สั่งให้เปลี่ยนเป็นตั้งรับ","more":"กองพลสดจากไซบีเรียและตะวันออกไกลมีส่วนสำคัญ — ส่วนหนึ่งเพราะหน่วยข่าวกรองรายงานว่าญี่ปุ่นจะไม่โจมตีสหภาพโซเวียตในปี 1941 (ผู้เรียบเรียง)","intl":"งานตะวันตกยุคแรกที่อาศัยบันทึกนายพลเยอรมันเน้น «นายพลฤดูหนาว» และโคลน งานรัสเซียและงานตะวันตกยุคใหม่เน้นการต้านทานของกองทัพแดง กำลังสำรองที่เตรียมไว้ลับ ๆ และการที่เยอรมันยืดเส้นส่งกำลังเกินตัว","src":"สไลด์ 17 · ผู้เรียบเรียง"},{"d":69.5,"fun":1,"when":"8.12.1941","h":"เชื่อมโยงกับไทย","ru":"8 декабря 1941 — высадка японцев в Таиланде","tx":"สองวันหลังแนวรบตะวันตกเริ่มรุก ญี่ปุ่นยกพลขึ้นบกในไทยไม่กี่ชั่วโมงหลังโจมตีเพิร์ลฮาร์เบอร์ ไทยทำสัญญาพันธไมตรีกับญี่ปุ่น (21.12.1941) และประกาศสงครามกับอังกฤษและสหรัฐฯ แต่ไม่ได้ประกาศสงครามกับสหภาพโซเวียต ซึ่งไทยเพิ่งมีความสัมพันธ์ทางการทูตด้วยตั้งแต่ 12.03.1941","src":"ผู้เรียบเรียง (en.wikipedia «Thailand in World War II»)"},{"d":77,"key":1,"at":[35.91,56.86],"h":"คลินและคาลีนินได้คืน — เยอรมันถอย","ru":"15.12 — освобождён Клин, 16.12 — Калинин; 16.12 — отступление германских войск","tx":"ปีกเหนือของเยอรมันถอยจากคลองมอสโก–วอลกา ทิ้งอาวุธหนักไว้บนถนนที่หิมะปกคลุม ฮิตเลอร์ปลดผู้บัญชาการทหารบกเบราคิทช์ (19.12) และบัญชาการกองทัพบกเอง พร้อมสั่งห้ามถอย","src":"สไลด์ 17 · ผู้เรียบเรียง"},{"d":99,"key":1,"h":"สิ้นสุดการรุกโต้ตอบ — ความพ่ายแพ้ใหญ่ครั้งแรกของเยอรมัน","ru":"7.01.1942 — Московская стратегическая наступательная операция завершилась; ГА «Центр» отброшена на 100–250 км","tx":"โวโลโคลัมสค์ (20.12) และคาลูกา (30.12) ได้คืน กลุ่มกองทัพ «กลาง» ถูกผลักถอยไป 100–250 กม. ภัยต่อมอสโกหมดไป เป็นความพ่ายแพ้ครั้งใหญ่ครั้งแรกของกองทัพเยอรมันในสงครามโลกครั้งที่ 2 และทำลาย <b>แผนสงครามสายฟ้าแลบ</b> <span class=\"vhm-ru\">(план «молниеносной войны» сорван)</span>","more":"สไลด์ 16: ความสูญเสีย เยอรมนี 153 000 คน สหภาพโซเวียต 514 000 คน — ดูตารางสำหรับตัวเลขจากแหล่งอื่น ในเวลาเดียวกันกองทัพแดงยึดรอสตอฟคืน (29.11) และทิควิน (9.12) — ดูแผนที่ย่อมุมขวาบน","src":"สไลด์ 16–17, 26 · ผู้เรียบเรียง"}]}