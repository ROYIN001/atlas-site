","โซเวียต: 10–12 พัน · Nicolle: ≈2 600 · ดานิเลฟสกี: อัศวิน 35–40 + บริวาร"]],"note":"จำนวนทหารไม่มีในแหล่งร่วมสมัย ตัวเลขประเมินต่างกันหลายสิบเท่า — «อัศวิน» ในพงศาวดารหมายถึงอัศวินพี่น้องของคณะเท่านั้น แต่ละคนมีบริวารและทหารราบติดตามอีกหลายคน (ผู้เรียบเรียง: ru/en.wikipedia)"}],"events":[{"d":0.05,"key":1,"at":[27.861,57.709],"h":"1240: อัศวินยึดอิซบอร์สก์และปัสคอฟ","ru":"Ливонский орден: захвачен Изборск, Псков","tx":"อัศวินเยอรมัน ทหารของบิชอปแห่งดอร์ปัต และอัศวินเดนมาร์กยึดป้อมอิซบอร์สก์ แล้วตีทัพปัสคอฟแตกและยึดเมืองปัสคอฟได้ ตามสไลด์เป้าหมายของคณะอัศวินคือทำลายกองทัพรุส และเปลี่ยนชาวรุสให้เป็นคาทอลิก","src":"สไลด์ 14 · ผู้เรียบเรียง (ru.wikipedia)"},{"d":0.7,"at":[29.032,59.709],"h":"ป้อมของอัศวินที่โคปอรีเย","ru":"крепость в Копорье, земля води","tx":"ปลายปี 1240 อัศวินเข้ายึดดินแดนของชาววอด <span class=\"vhm-ru\">(водь)</span> ริมอ่าวฟินแลนด์ สร้างป้อมไม้ที่โคปอรีเย และส่งกองปล้นสะดมเข้ามาใกล้นอฟโกรอด ชาวนอฟโกรอดจึงต้องเชิญอเล็กซานเดอร์กลับมา","src":"ผู้เรียบเรียง (ru.wikipedia «Ледовое побоище»)"},{"d":1.3,"key":1,"at":[29.032,59.709],"h":"1241: อเล็กซานเดอร์ยึดโคปอรีเยคืน","ru":"1241 г. — взятие Копорья","tx":"อเล็กซานเดอร์กลับนอฟโกรอด รวบรวมกำลังแล้วบุกยึดป้อมโคปอรีเยและทำลายทิ้ง ภัยทางเหนือหมดไป","src":"ผู้เรียบเรียง"},{"d":2.2,"key":1,"at":[28.333,57.817],"h":"มีนาคม 1242: ปลดปล่อยปัสคอฟ","ru":"освобождение Пскова","tx":"อเล็กซานเดอร์กับน้องชาย อันเดรย์ ยาโรสลาวิช <span class=\"vhm-ru\">(Андрей Ярославич)</span> ที่นำกองทัพซูซดาลมาสมทบ บุกยึดปัสคอฟคืนอย่างรวดเร็ว","src":"ผู้เรียบเรียง"},{"d":3.1,"at":[27.3,58.2],"h":"นำสงครามเข้าไปในดินแดนข้าศึก","ru":"поход в земли эстов (Дерптское епископство)","tx":"ต้นเดือนเมษายน อเล็กซานเดอร์ไม่รอให้ข้าศึกมาหา แต่ยกทัพเข้าดินแดนชาวเอสต์ในเขตสังฆมณฑลดอร์ปัต ปล่อยกองทหารออกหาเสบียง","src":"ผู้เรียบเรียง"},{"d":3.4,"key":1,"at":[27.19,58.16],"h":"กองหน้าของโดมาชถูกตีแตก","ru":"потеря разведотряда Домаша Твердиславича","tx":"กองหน้าของโดมาช ทแวร์ดิสลาวิช <span class=\"vhm-ru\">(Домаш Твердиславич)</span> น้องชายของผู้ปกครองนอฟโกรอด กับแม่ทัพเคอร์เบต <span class=\"vhm-ru\">(Кербет)</span> ปะทะกองทัพเยอรมันและชาวชุด «ที่สะพาน» และถูกตีแตก โดมาชเสียชีวิต — อเล็กซานเดอร์รู้ทันทีว่ากองทัพหลักของอัศวินกำลังมา","warn":"สไลด์ 14 เขียนชื่อว่า «Домаш Твердиславович» ในพงศาวดารเขียนว่า <b>«Домаш Твердиславич»</b> (เป็นรูปสะกดแบบเก่า ไม่ใช่ความผิดร้ายแรง)","src":"สไลด์ 14 · ผู้เรียบเรียง"},{"d":3.8,"key":1,"at":[27.52,58.287],"h":"ถอยมาเลือกสนามรบเองบนน้ำแข็ง","ru":"Чудское озеро, Узмень, у Вороньего камня","tx":"อเล็กซานเดอร์ถอยกลับข้ามน้ำแข็งมาตั้งทัพที่ฝั่งตะวันออกของช่วงแคบอุซเมน <span class=\"vhm-ru\">(Узмень)</span> ใกล้ «หินอีกา» <span class=\"vhm-ru\">(Вороний камень)</span> ข้าศึกต้องบุกข้ามน้ำแข็งโล่งเข้าหา ส่วนทหารรุสมีฝั่งของตนอยู่ข้างหลัง","src":"ผู้เรียบเรียง (ru.wikipedia)"},{"d":4.8,"key":1,"at":[27.527,58.2885],"h":"5 เมษายน: จัดทัพผิดธรรมเนียม — กำลัง 2/3 อยู่ที่ปีก","ru":"центр — 1/3 сил с лучниками впереди, фланги — 2/3","tx":"ปกติกองทัพรุสวางกำลังหลักไว้ตรงกลาง แต่ครั้งนี้อเล็กซานเดอร์วางเพียงหนึ่งในสามไว้กลาง มีพลธนูอยู่ข้างหน้า ส่วนสองในสามอยู่ที่กรมปีกซ้ายและกรมปีกขวา <span class=\"vhm-ru\">(полки левой и правой руки)</span> ซึ่งมีทหารม้าและกองทหารของเจ้าชาย","more":"เขารู้ว่าอัศวินจะบุกด้วยรูปลิ่มตรงเข้ากลางเสมอ จึงทำให้กลาง «รับแรงกระแทก» แล้วเก็บหมัดหนักไว้ที่สองข้าง","src":"ผู้เรียบเรียง (ru.wikipedia «Ледовое побоище»)"},{"d":5.2,"fun":1,"at":[27.49,58.2885],"h":"ทำไมเรียกว่า «หมู»","ru":"«свинья» — клин рыцарей","tx":"พงศาวดารรุสเรียกรูปลิ่มของอัศวินว่า «หมู» <span class=\"vhm-ru\">(свинья)</span> — อัศวินเกราะหนักอยู่ที่หัวลิ่มและสองข้าง ทหารราบเบา (คนรับใช้และชาวเอสต์) อยู่ข้างใน รูปร่างเหมือนหัวหมูที่พุ่งจมูกนำ เหมาะสำหรับทะลุแนว แต่หันเลี้ยวยาก","src":"ผู้เรียบเรียง"},{"d":5.6,"key":1,"at":[27.515,58.2885],"h":"ลิ่มอัศวินพุ่งทะลุกลาง","ru":"«свинья» прорывает центр русских","tx":"ลิ่มข้ามน้ำแข็งเข้ามา ตีฝ่าพลธนูและแนวกลางของรุสได้ตามที่อเล็กซานเดอร์คาดไว้ แต่เมื่อทะลุเข้ามาแล้ว ลิ่มหยุดวิ่ง ความเร็วหมดไป และติดอยู่ระหว่างทหารรุสสองข้าง","src":"ผู้เรียบเรียง"},{"d":6.5,"key":1,"at":[27.519,58.2885],"h":"ปีกทั้งสองตีกระหนาบ — ลิ่มถูกล้อม","ru":"удар полков правой и левой руки во фланги","tx":"กรมปีกซ้ายและปีกขวาที่มีกำลังสองในสามของทั้งทัพเลี้ยวเข้าตีสองข้างของลิ่มพร้อมกัน อัศวินที่เบียดกันแน่นหันไม่ได้และถูกล้อมไว้","more":"ให้เทียบกับกันไน (บรรยายที่ 1): กลางอ่อน ปีกแข็ง แล้วโอบสองข้าง — หลักการตีโอบล้อมเดียวกัน ใช้ในอีก 1 450 ปีต่อมา","src":"ผู้เรียบเรียง"},{"d":7.1,"at":[27.49,58.2915],"h":"ทหารของบิชอปหนีก่อน อัศวินสู้จนแตก","ru":"бегство дерптцев; рыцари разбиты","tx":"ทหารราบของบิชอปแห่งดอร์ปัตและชาวชุดไม่รอให้วงล้อมปิด พากันหนีกลับข้ามน้ำแข็ง อัศวินที่ถูกล้อมถูกฆ่าหรือถูกจับ","src":"ผู้เรียบเรียง"},{"d":7.6,"key":1,"at":[27.44,58.2862],"h":"ไล่ตาม 7 เวิร์สต์ถึงฝั่งตะวันตก","ru":"преследование на 7 вёрст до Суболичского берега","tx":"ทหารรุสไล่ตามข้าศึกข้ามน้ำแข็งราว 7 เวิร์สต์ <span class=\"vhm-ru\">(верста ≈ 1,07 км)</span> จนถึงฝั่งตะวันตก (ฝั่งซูโบลิช) ข้าศึกบางส่วนตกลงไปในน้ำแข็งบางที่ «ซิโกวิตซา»","intl":"ภาพ «อัศวินจมน้ำแข็งทั้งกองทัพ» ไม่มีในแหล่งร่วมสมัย นักวิจัยตะวันตก (เช่น ด. ออสโตรฟสกี) ชี้ว่ามาจากภาพยนตร์ «อเล็กซานเดอร์ เนฟสกี» ของไอเซนสไตน์ (1938) — ในพงศาวดาร พูดถึงเพียงการไล่ตามบนน้ำแข็ง","src":"ผู้เรียบเรียง (ru/en.wikipedia)"},{"d":8,"fun":1,"h":"ภาพยนตร์ที่สร้างตำนาน","ru":"фильм С. Эйзенштейна «Александр Невский» (1938)","tx":"ภาพยนตร์ของไอเซนสไตน์ พร้อมดนตรีของโปรโคเฟียฟ ทำให้ภาพน้ำแข็งแตกใต้อัศวินกลายเป็นความทรงจำของคนทั้งประเทศ ปี 1942 สหภาพโซเวียตตั้งเครื่องอิสริยาภรณ์อเล็กซานเดอร์ เนฟสกีสำหรับนายทหาร และเพราะไม่มีภาพเหมือนจริงของเจ้าชาย จึงใช้ใบหน้าของนักแสดงนิโคไล เชียร์คาซอฟ <span class=\"vhm-ru\">(Николай Черкасов)</span> จากภาพยนตร์เป็นแบบ","src":"ผู้เรียบเรียง"},{"d":8.6,"key":1,"at":[27.515,58.2885],"h":"ผล: สันติภาพ คณะอัศวินคืนดินแดน","ru":"День воинской славы: 5 (18) апреля 1242 г.","tx":"ปีเดียวกันคณะอัศวินส่งทูตมาขอสันติภาพ สละดินแดนที่ยึดได้ช่วง 1240–1241 แลกเปลี่ยนเชลยและตัวประกัน การรุกของอัศวินเข้าดินแดนนอฟโกรอดหยุดลง ปัจจุบันรัสเซียถือวันนี้เป็นวันเกียรติยศทางทหาร (สไลด์ 15)","warn":"สไลด์ 14 ให้ความสูญเสีย «22 рыцарей» แต่พงศาวดารสัมผัสลิโวเนียให้ <b>20</b> ตาย 6 ถูกจับ · สไลด์ 15 ใช้วันที่ «5 (18) апреля» ตามกฎหมายวันเกียรติยศทางทหาร แต่ถ้าแปลงเป็นปฏิทินเกรกอเรียนตามหลักวิชาการ ศตวรรษที่ 13 ต่างกัน 7 วัน คือ <b>12 เมษายน</b> (ru.wikipedia)","intl":"ขนาดของการรบยังถกเถียง: ตำราโซเวียตว่าอัศวิน 10–12 พันปะทะรุส 15–17 พัน นักประวัติศาสตร์รัสเซียบางคน (ดานิเลฟสกี) ว่ามีผู้ร่วมรบเพียงไม่กี่ร้อย นักวิชาการตะวันตก (เฟนเนลล์) มองว่าเป็นการรบชายแดนธรรมดาที่ถูกทำให้เป็น «ตำนานชาติ» โดยเฉพาะในยุคสตาลิน","src":"สไลด์ 14–15 · ผู้เรียบเรียง"},{"d":9.1,"fun":1,"at":[27.624,58.291],"h":"พิพิธภัณฑ์ในหมู่บ้านนักสำรวจ","ru":"Самолва — экспедиция Г. Караева (1958–59)","tx":"ปี 1958 คณะสำรวจของสถาบันวิทยาศาสตร์โซเวียตภายใต้ ก. คาราเยฟ ตั้งกองบัญชาการที่หมู่บ้านซามอลวา <span class=\"vhm-ru\">(Самолва)</span> เพื่อหาที่ตั้งสนามรบ วันที่ 22 เม.ย. 2012 วาระครบ 770 ปี ที่นี่เปิดพิพิธภัณฑ์ของการรบ","src":"ผู้เรียบเรียง (dic.academic.ru)"}]}